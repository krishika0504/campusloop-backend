generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  COLLEGE_ADMIN
  STUDENT
}

enum VerificationStatus {
  UNVERIFIED
  EMAIL_PENDING
  ID_PENDING
  PENDING
  VERIFIED
  REJECTED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum CollegeStatus {
  ACTIVE
  PENDING_APPROVAL
  SUSPENDED
}

enum TransactionType {
  BUY
  SELL
  BORROW
  EXCHANGE
  DONATE
}

enum TransactionStatus {
  LISTED
  REQUESTED
  NEGOTIATING
  AGREED
  ACCEPTED
  READY_FOR_PICKUP
  BORROWED
  RETURN_PENDING
  RETURNED
  COMPLETED
  RATED
  CANCELLED
  DISPUTED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  EXPIRED
  CANCELLED
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationTarget {
  ALL
  COLLEGE
  USER
}

enum SubscriptionPlan {
  FREE_TRIAL
  STANDARD
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum RevenueSource {
  SUBSCRIPTION
  TRANSACTION_FEE
  PARTNERSHIP
  PREMIUM
}

model College {
  id                 String        @id @default(uuid())
  name               String
  code               String        @unique
  emailDomain        String        @unique
  address            String?
  city               String
  state              String
  country            String        @default("India")
  logo               String?
  contactPerson      String?
  contactEmail       String
  contactPhone       String?
  adminName          String?
  status             CollegeStatus @default(ACTIVE)
  subscriptionPlan   String        @default("STANDARD")
  subscriptionStatus String        @default("ACTIVE")
  circularityScore   Float         @default(75.0)
  studentCount       Int           @default(0)
  listingCount       Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  students        User[]           @relation("CollegeStudents")
  collegeAdmins   CollegeAdmin[]
  items           Item[]
  pickupLocations PickupLocation[]
  transactions    Transaction[]
  subscriptions   Subscription[]
  revenues        Revenue[]
  notifications   Notification[]
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  passwordHash       String
  name               String
  role               Role               @default(STUDENT)
  collegeId          String?
  college            College?           @relation("CollegeStudents", fields: [collegeId], references: [id], onDelete: SetNull)
  department         String?
  rollNumber         String?
  academicYear       String?
  avatarUrl          String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verificationNote   String?
  verifiedAt         DateTime?
  trustRating        Float              @default(5.0)
  totalTransactions  Int                @default(0)
  co2SavedKg         Float              @default(0.0)
  moneySavedUsd      Float              @default(0.0)
  itemsCirculated    Int                @default(0)
  strikes            Int                @default(0)
  status             AccountStatus      @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  adminAssignments      CollegeAdmin[]
  ownedItems            Item[]         @relation("ItemOwner")
  sentRequests          Request[]      @relation("UserRequests")
  conversationsAsA      Conversation[] @relation("ParticipantA")
  conversationsAsB      Conversation[] @relation("ParticipantB")
  sentMessages          Message[]
  buyerOffers           Offer[]        @relation("BuyerOffers")
  sellerOffers          Offer[]        @relation("SellerOffers")
  buyerTransactions     Transaction[]  @relation("BuyerTransactions")
  sellerTransactions    Transaction[]  @relation("SellerTransactions")
  givenRatings          Rating[]       @relation("GivenRatings")
  receivedRatings       Rating[]       @relation("ReceivedRatings")
  submittedReports      Report[]       @relation("Reporter")
  targetedReports       Report[]       @relation("ReportedUser")
  resolvedReports       Report[]       @relation("ReportResolver")
  receivedNotifications Notification[] @relation("UserNotification")
  auditLogs             AuditLog[]

  @@index([email])
  @@index([collegeId])
  @@index([role])
}

model CollegeAdmin {
  id         String   @id @default(uuid())
  userId     String
  collegeId  String
  assignedAt DateTime @default(now())
  assignedBy String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
  @@index([collegeId])
}

model Item {
  id                     String          @id @default(uuid())
  title                  String
  description            String
  category               String
  condition              String
  price                  Float           @default(0.0)
  transactionType        TransactionType @default(SELL)
  exchangePreferences    String?
  maxBorrowDays          Int?
  courseCode             String?
  isAvailable            Boolean         @default(true)
  isRecommended          Boolean         @default(false)
  isNearby               Boolean         @default(false)
  isDigital              Boolean         @default(false)
  digitalProvider        String?
  digitalCodePlaceholder String?
  status                 String          @default("ACTIVE") // ACTIVE, PENDING_MODERATION, HIDDEN, REMOVED, SOLD, BORROWED
  pickupLocationId       String?
  pickupLocation         PickupLocation? @relation(fields: [pickupLocationId], references: [id], onDelete: SetNull)
  pickupLocationName     String?
  collegeId              String
  college                College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  sellerId               String
  seller                 User            @relation("ItemOwner", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  images        ItemImage[]
  requests      Request[]
  conversations Conversation[]
  offers        Offer[]
  transactions  Transaction[]
  reports       Report[]

  @@index([collegeId])
  @@index([sellerId])
  @@index([category])
  @@index([transactionType])
  @@index([status])
}

model ItemImage {
  id        String   @id @default(uuid())
  itemId    String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model Request {
  id          String   @id @default(uuid())
  itemId      String
  requesterId String
  message     String?
  status      String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  item      Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  requester User @relation("UserRequests", fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([requesterId])
}

model Conversation {
  id             String    @id @default(uuid())
  itemId         String?
  participantAId String
  participantBId String
  lastMessageAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  item         Item?     @relation(fields: [itemId], references: [id], onDelete: SetNull)
  participantA User      @relation("ParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB User      @relation("ParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  messages     Message[]
  offers       Offer[]

  @@index([participantAId])
  @@index([participantBId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  text           String
  type           String   @default("TEXT") // TEXT, OFFER, SYSTEM, IMAGE
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Offer {
  id             String      @id @default(uuid())
  conversationId String?
  itemId         String
  buyerId        String
  sellerId       String
  originalPrice  Float
  offeredPrice   Float
  status         OfferStatus @default(PENDING)
  counterPrice   Float?
  counterBy      String?
  message        String?
  parentOfferId  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  item         Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  buyer        User          @relation("BuyerOffers", fields: [buyerId], references: [id], onDelete: Cascade)
  seller       User          @relation("SellerOffers", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([buyerId])
  @@index([sellerId])
}

model Transaction {
  id                 String            @id @default(uuid())
  itemId             String
  buyerId            String
  sellerId           String
  collegeId          String
  transactionType    TransactionType
  agreedPrice        Float
  status             TransactionStatus @default(REQUESTED)
  pickupLocationId   String?
  pickupLocationName String?
  pickupScheduledAt  DateTime?
  pickupConfirmedAt  DateTime?
  qrVerificationCode String?           @unique
  borrowStartDate    DateTime?
  expectedReturnDate DateTime?
  actualReturnDate   DateTime?
  exchangeItemTitle  String?
  disputeReason      String?
  resolutionNote     String?
  createdAt          DateTime          @default(now())
  completedAt        DateTime?
  updatedAt          DateTime          @updatedAt

  item           Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  buyer          User            @relation("BuyerTransactions", fields: [buyerId], references: [id], onDelete: Cascade)
  seller         User            @relation("SellerTransactions", fields: [sellerId], references: [id], onDelete: Cascade)
  college        College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  pickupLocation PickupLocation? @relation(fields: [pickupLocationId], references: [id], onDelete: SetNull)
  ratings        Rating[]
  reports        Report[]

  @@index([collegeId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model PickupLocation {
  id             String   @id @default(uuid())
  collegeId      String
  name           String
  building       String
  description    String?
  operatingHours String   @default("8:00 AM - 8:00 PM")
  safetyTips     String?
  isDefault      Boolean  @default(false)
  status         String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  college      College       @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  items        Item[]
  transactions Transaction[]

  @@index([collegeId])
}

model Rating {
  id            String   @id @default(uuid())
  transactionId String
  raterId       String
  rateeId       String
  rating        Float    @default(5.0)
  review        String?
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  rater       User        @relation("GivenRatings", fields: [raterId], references: [id], onDelete: Cascade)
  ratee       User        @relation("ReceivedRatings", fields: [rateeId], references: [id], onDelete: Cascade)

  @@unique([transactionId, raterId])
  @@index([rateeId])
}

model Report {
  id             String         @id @default(uuid())
  reporterId     String
  reportedUserId String?
  listingId      String?
  transactionId  String?
  reason         String
  description    String
  status         ReportStatus   @default(OPEN)
  priority       ReportPriority @default(MEDIUM)
  notes          String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  reporter     User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User?        @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  listing      Item?        @relation(fields: [listingId], references: [id], onDelete: SetNull)
  transaction  Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  resolvedBy   User?        @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
}

model Notification {
  id             String             @id @default(uuid())
  title          String
  message        String
  targetAudience NotificationTarget @default(ALL)
  collegeId      String?
  userId         String?
  scheduledAt    DateTime?
  sentAt         DateTime           @default(now())
  status         String             @default("SENT") // DRAFT, SCHEDULED, SENT
  createdAt      DateTime           @default(now())

  college College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  user    User?    @relation("UserNotification", fields: [userId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([userId])
}

model Subscription {
  id           String             @id @default(uuid())
  collegeId    String
  plan         SubscriptionPlan   @default(STANDARD)
  status       SubscriptionStatus @default(ACTIVE)
  startDate    DateTime           @default(now())
  endDate      DateTime
  amount       Float
  billingCycle String             @default("ANNUAL")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
}

model Revenue {
  id          String        @id @default(uuid())
  collegeId   String?
  source      RevenueSource @default(SUBSCRIPTION)
  amount      Float
  description String
  metadata    Json?
  createdAt   DateTime      @default(now())

  college College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)

  @@index([collegeId])
  @@index([source])
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  adminName  String
  role       Role
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  timestamp  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([entityType])
}
